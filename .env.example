# Configuration pour `docker compose up`. Copier en `.env` (a la racine, a
# cote de docker-compose.yml) et ajuster — notamment APP_KEY et les mots de
# passe, avant tout usage hors poste de developpement local.
#
#   cp .env.example .env
#   docker compose up --build

APP_NAME=HerboQuiz
APP_ENV=local
# Genere avec : docker run --rm php:8.3-cli-alpine php -r "echo 'base64:'.base64_encode(random_bytes(32));"
APP_KEY=base64:Ea4FadSBLzL2j/4QWQEAD4WSDr3NT5Y+K6UCU+eXGO4=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_LEVEL=warning

DB_DATABASE=herboquiz
DB_USERNAME=herboquiz
DB_PASSWORD=herboquiz
DB_PORT=5432

HERBOQUIZ_PROPRIETAIRE=Kaido

# true = peuple reglages/acces/membres (DatabaseSeeder) au premier demarrage.
DB_SEED=true

# Doit etre joignable depuis le navigateur de l'utilisateur, pas depuis le
# reseau interne Docker (voir herboquiz_frontend/Dockerfile).
VITE_API_URL=http://localhost:8000/api
