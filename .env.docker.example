# Variables pour `docker run --env-file .env.docker <image>`. Copier en
# .env.docker et ajuster avant tout usage hors poste de developpement local
# (la valeur DB_URL par defaut, dans le Dockerfile, pointe deja vers la base
# Render du projet — ne la surcharger ici que pour utiliser une AUTRE base).
#
#   cp .env.docker.example .env.docker
#   docker build -t herboquiz .
#   docker run -p 8000:8000 --env-file .env.docker herboquiz

APP_ENV=production
# Genere avec : docker run --rm php:8.4-cli-alpine php -r "echo 'base64:'.base64_encode(random_bytes(32));"
APP_KEY=base64:Ea4FadSBLzL2j/4QWQEAD4WSDr3NT5Y+K6UCU+eXGO4=
APP_DEBUG=false
APP_URL=http://localhost:8000

# Ne decommenter que pour pointer vers une base differente de celle par
# defaut du Dockerfile :
# DB_URL=postgresql://utilisateur:motdepasse@hote/base

HERBOQUIZ_PROPRIETAIRE=Kaido

# true = peuple reglages/acces/membres (DatabaseSeeder) au premier demarrage.
DB_SEED=true
