# Variables pour `docker run --env-file .env.docker <image>`. Copier en
# .env.docker et ajuster — notamment APP_KEY et les mots de passe — avant
# tout usage hors poste de developpement local.
#
#   cp .env.docker.example .env.docker
#   docker build -t herboquiz .
#   docker run -p 8080:80 --env-file .env.docker \
#       -v herboquiz-pgdata:/var/lib/postgresql/data herboquiz

APP_ENV=production
# Genere avec : docker run --rm php:8.3-cli-alpine php -r "echo 'base64:'.base64_encode(random_bytes(32));"
APP_KEY=base64:Ea4FadSBLzL2j/4QWQEAD4WSDr3NT5Y+K6UCU+eXGO4=
APP_DEBUG=false
APP_URL=http://localhost:8080

DB_DATABASE=herboquiz
DB_USERNAME=herboquiz
DB_PASSWORD=herboquiz

HERBOQUIZ_PROPRIETAIRE=Kaido

# true = peuple reglages/acces/membres (DatabaseSeeder) au premier demarrage.
DB_SEED=true
